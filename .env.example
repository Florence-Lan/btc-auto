# Binance USD-M mainnet. Keep real secrets only in .env, which is ignored by Git.
# Use an API key restricted to Futures trading, disable withdrawals, and bind trusted IPs.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Simulation uses Binance mainnet realtime data but never sends an order.
SIM_INITIAL_BALANCE_USDT=100
SIM_MAX_LEVERAGE=2
SIM_MAX_NOTIONAL_USDT=0
SIM_TAKER_FEE=0.00045
SIM_SLIPPAGE_BPS=1.0

# Live mode remains unavailable until all three settings are explicit.
LIVE_TRADING_ENABLED=false
LIVE_MAX_NOTIONAL_USDT=
LIVE_LEVERAGE=1

# Do not execute a strategy target older than this threshold.
MAX_SIGNAL_AGE_SECONDS=900

# Optional LLM entry gate. It can only reject new/increased exposure; reductions and exits bypass it.
# Keep disabled until simulation results have been reviewed. API errors fail closed for new risk.
LLM_TRADE_GATE_ENABLED=false
# codex reuses the local `codex login` ChatGPT membership session and needs no API key.
LLM_PROVIDER=codex
CODEX_BIN=
LLM_CODEX_MODEL=
LLM_CODEX_TIMEOUT_SECONDS=90
LLM_MIN_CONFIDENCE=0.70

# Optional alternative: set LLM_PROVIDER=openai and configure an API account below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-nano
LLM_TIMEOUT_SECONDS=12
